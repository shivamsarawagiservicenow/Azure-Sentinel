{
  "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
  "name": "ServiceNowConnectorDefinition",
  "apiVersion": "2022-09-01-preview",
  "location": "[parameters('location')]",
  "kind": "Customizable",
  "properties": {
    "connectorUiConfig": {
      "title": "ServiceNow Attack Path Connector",
      "publisher": "Microsoft",
      "descriptionMarkdown": "The ServiceNow Attack Path Connector ingests asset, vulnerability, and service data from your ServiceNow instance into Microsoft Sentinel.",
      "graphQueries": [
        {
          "metricName": "Devices Received",
          "legend": "Custom_ServiceNowDevices_CL",
          "baseQuery": "Custom_ServiceNowDevices_CL"
        },
        {
          "metricName": "Vulnerable Items Received",
          "legend": "Custom_ServiceNowVulnerableItems_CL",
          "baseQuery": "Custom_ServiceNowVulnerableItems_CL"
        }
      ],
      "sampleQueries": [
        {
          "description": "Sample of ServiceNow Devices",
          "query": "Custom_ServiceNowDevices_CL\n | sort by TimeGenerated desc"
        },
        {
          "description": "Sample of ServiceNow Vulnerable Items",
          "query": "Custom_ServiceNowVulnerableItems_CL\n | sort by TimeGenerated desc"
        }
      ],
      "dataTypes": [
        {
          "name": "Custom_ServiceNowDevices_CL",
          "lastDataReceivedQuery": "Custom_ServiceNowDevices_CL\n            | summarize Time = max(TimeGenerated)\n            | where isnotempty(Time)"
        },
        {
          "name": "Custom_ServiceNowVulnerableItems_CL",
          "lastDataReceivedQuery": "Custom_ServiceNowVulnerableItems_CL\n            | summarize Time = max(TimeGenerated)\n            | where isnotempty(Time)"
        }
      ],
      "connectivityCriteria": [
        {
          "type": "HasDataConnectors"
        }
      ],
      "availability": {
        "isPreview": true
      },
      "permissions": {
        "resourceProvider": [
          {
            "provider": "Microsoft.OperationalInsights/workspaces",
            "permissionsDisplayText": "Read and Write permissions are required.",
            "providerDisplayName": "Workspace",
            "scope": "Workspace",
            "requiredPermissions": {
              "write": true,
              "read": true,
              "delete": true
            }
          }
        ],
        "customs": [
          {
            "name": "ServiceNow Service Account",
            "description": "A ServiceNow user account with read-only roles is required."
          }
        ]
      },
      "instructionSteps": [
        {
          "description": "Connect your ServiceNow instance to Microsoft Sentinel.",
          "instructions": [
            {
              "type": "DataConnectorsGrid",
              "parameters": {
                "mapping": [
                  {
                    "columnName": "ServiceNow Instance",
                    "columnValue": "properties.request.apiEndpoint"
                  }
                ],
                "menuItems": ["DeleteConnector"]
              }
            },
            {
              "type": "ContextPane",
              "parameters": {
                "isPrimary": true,
                "label": "Add Connector",
                "title": "Connect to ServiceNow",
                "contextPaneType": "DataConnectorsContextPane",
                "instructionSteps": [
                  {
                    "instructions": [
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "ServiceNow Instance Name",
                          "placeholder": "my-instance",
                          "name": "instance",
                          "type": "string"
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "ServiceNow Username",
                          "placeholder": "User Name",
                          "name": "username",
                          "type": "securestring"
                        }
                      },
                      {
                        "type": "Textbox",
                        "parameters": {
                          "label": "ServiceNow Password",
                          "name": "password",
                          "type": "password"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
